# ---------------------------------------------------------------------------
# RRIV web — environment configuration
#
# Copy this file to `.env` and adjust the values for your environment.
# Vite only exposes variables prefixed with `VITE_` to client code, so every
# value below MUST keep that prefix. Values without it are invisible to the app.
#
# All four variables are REQUIRED. src/config.ts validates them at startup and
# throws a readable error if any are missing or malformed.
# ---------------------------------------------------------------------------

# Existing RRIV REST API (no trailing slash). OpenAPI docs: GET /version.yaml
VITE_RRIV_API_BASE_URL=http://localhost:3007

# Keycloak OIDC provider (no trailing slash)
VITE_KEYCLOAK_URL=http://localhost:8080

# Keycloak realm that issues tokens the RRIV API trusts
VITE_KEYCLOAK_REALM=master

# Public (PKCE) Keycloak client used by this SPA
VITE_KEYCLOAK_CLIENT_ID=rriv-web

# Telemetry is served by rriv-api (GET /device/:id/telemetry); data-api is
# internal-only and needs no URL here.
